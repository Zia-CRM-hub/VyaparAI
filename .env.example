# Copy to .env for local development. NEVER commit real secrets.

# PostgreSQL (docker compose up db, or `npm run db:local` for embedded Postgres)
DATABASE_URL="postgresql://vyapar:vyapar@localhost:5432/vyaparai?schema=public"

# Auth.js - generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# Redis (rate limiting / jobs from Phase 6). Optional in Phase 1: falls back to in-memory.
REDIS_URL=""

# Seed
SEED_OWNER_PASSWORD="ChangeMe!12345"
