// VyaparAI - Phase 1 schema (identity, tenancy, RBAC, audit, customers foundation).
// Conventions: UUID primary keys, UTC timestamps, tenantId on every tenant-owned row,
// Decimal (never Float) for money/quantity in later phases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum SubscriptionPlan {
  TRIAL
  STARTER
  GROWTH
  PRO
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AgeGroup {
  BABY
  KID
  TEEN
  ADULT
  SENIOR
}

enum OrderStatus {
  ORDER_RECEIVED
  MEASUREMENT
  CUTTING
  STITCHING
  TRIAL
  ALTERATION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK
}

enum ConsentPurpose {
  WHATSAPP_MESSAGING
  MARKETING
  MEASUREMENT_DATA
  PHOTO_STORAGE
}

// ───────────── Tenancy ─────────────

model Tenant {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  slug          String       @unique
  status        TenantStatus @default(ACTIVE)
  gstin         String?
  phone         String?
  address       String?
  city          String?
  /// Branding / theme (per tenant)
  brandColor    String       @default("#7c2d5b")
  logoDataUrl   String?      @db.Text
  bannerText    String?
  bannerEnabled Boolean      @default(false)
  bannerTone    String       @default("info")
  /// Sequential human-friendly order numbers per tenant
  nextOrderNo   Int          @default(1)
  locale        String       @default("en")
  timezone      String       @default("Asia/Kolkata")
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  branches        Branch[]
  memberships     Membership[]
  roles           Role[]
  customers       Customer[]
  familyMembers   FamilyMember[]
  measurementSets MeasurementSet[]
  orders          Order[]
  payments        Payment[]
  subscription    Subscription?
  entitlements    FeatureEntitlement[]
}

model Branch {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  code      String
  city      String?
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  membershipBranches MembershipBranch[]
  customers          Customer[]
  orders             Order[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@index([tenantId])
}

// ───────────── Identity & RBAC ─────────────

/// Global identity. A user may belong to several tenants through Membership.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  name            String
  passwordHash    String
  locale          String    @default("en")
  isPlatformAdmin Boolean   @default(false)
  failedLogins    Int       @default(0)
  lockedUntil     DateTime? @db.Timestamptz(3)
  lastLoginAt     DateTime? @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)

  memberships Membership[]
}

/// Global catalogue of permission keys (for example customer:read). Seeded from code.
model Permission {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique
  description String

  roles RolePermission[]
}

model Role {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  name      String
  isSystem  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  permissions RolePermission[]
  memberships Membership[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model RolePermission {
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Membership {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @db.Uuid
  userId      String           @db.Uuid
  roleId      String           @db.Uuid
  status      MembershipStatus @default(ACTIVE)
  /// true = access to every branch of the tenant; false = only MembershipBranch rows.
  allBranches Boolean          @default(false)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role               @relation(fields: [roleId], references: [id])
  branches MembershipBranch[]

  assignedOrders Order[]

  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([userId])
}

model MembershipBranch {
  membershipId String @db.Uuid
  branchId     String @db.Uuid
  tenantId     String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  // Composite FK guarantees the branch belongs to the same tenant as the membership.
  branch     Branch     @relation(fields: [tenantId, branchId], references: [tenantId, id], onDelete: Cascade)

  @@id([membershipId, branchId])
  @@index([tenantId])
}

// ───────────── Customers (foundation; full CRM in Phase 2) ─────────────

model Customer {
  id                String    @id @default(uuid()) @db.Uuid
  tenantId          String    @db.Uuid
  branchId          String?   @db.Uuid
  name              String
  phone             String
  email             String?
  preferredLanguage String    @default("en")
  notes             String?
  /// Soft-delete / DPDP erasure marker. The erasure workflow lands in Phase 2.
  deletedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [tenantId, branchId], references: [tenantId, id])
  consents      Consent[]
  familyMembers FamilyMember[]
  orders        Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, phone])
  @@index([tenantId, name])
  @@index([tenantId, branchId])
}

/// Append-only consent ledger (latest row per customer+purpose is the current state).
model Consent {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @db.Uuid
  customerId   String         @db.Uuid
  purpose      ConsentPurpose
  granted      Boolean
  source       String
  recordedById String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)

  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId, purpose, createdAt])
}

// ───────────── Audit ─────────────

/// Append-only. Never updated or deleted by application code.
model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([actorUserId])
}

// ───────────── SaaS ─────────────

model Subscription {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @unique @db.Uuid
  plan        SubscriptionPlan   @default(TRIAL)
  status      SubscriptionStatus @default(TRIALING)
  trialEndsAt DateTime?          @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model FeatureEntitlement {
  id       String  @id @default(uuid()) @db.Uuid
  tenantId String  @db.Uuid
  feature  String
  enabled  Boolean @default(true)
  limit    Int?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
}

// ───────────── Family, measurements, orders, payments ─────────────

/// A person the customer orders for (self, spouse, child...). Each has own measurements.
model FamilyMember {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  customerId  String    @db.Uuid
  name        String
  relation    String    @default("Self")
  gender      Gender
  ageGroup    AgeGroup
  dateOfBirth DateTime? @db.Date
  notes       String?
  isSelf      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)
  measurements MeasurementSet[]
  orders       Order[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId])
}

/// Immutable measurement version for one person + garment. A new save creates a new version.
model MeasurementSet {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  familyMemberId String   @db.Uuid
  garment        String
  version        Int
  /// { fieldKey: centimetres }
  values         Json
  notes          String?
  createdById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member FamilyMember @relation(fields: [tenantId, familyMemberId], references: [tenantId, id], onDelete: Cascade)
  orders Order[]

  @@unique([tenantId, familyMemberId, garment, version])
  @@unique([tenantId, id])
}

model Order {
  id                   String      @id @default(uuid()) @db.Uuid
  tenantId             String      @db.Uuid
  orderNo              Int
  branchId             String?     @db.Uuid
  customerId           String      @db.Uuid
  familyMemberId       String      @db.Uuid
  garment              String
  description          String?
  status               OrderStatus @default(ORDER_RECEIVED)
  /// The exact measurement version this order is made from.
  measurementSetId     String?     @db.Uuid
  promisedDate         DateTime    @db.Date
  assignedMembershipId String?     @db.Uuid
  charges              Decimal     @db.Decimal(12, 2)
  deliveredAt          DateTime?   @db.Timestamptz(3)
  deliveryNote         String?
  createdById          String?     @db.Uuid
  createdAt            DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime    @updatedAt @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?              @relation(fields: [tenantId, branchId], references: [tenantId, id])
  customer    Customer             @relation(fields: [tenantId, customerId], references: [tenantId, id])
  member      FamilyMember         @relation(fields: [tenantId, familyMemberId], references: [tenantId, id])
  measurement MeasurementSet?      @relation(fields: [tenantId, measurementSetId], references: [tenantId, id])
  assignedTo  Membership?          @relation(fields: [tenantId, assignedMembershipId], references: [tenantId, id])
  payments    Payment[]
  history     OrderStatusHistory[]

  @@unique([tenantId, orderNo])
  @@unique([tenantId, id])
  @@index([tenantId, status])
  @@index([tenantId, promisedDate])
  @@index([tenantId, customerId])
  @@index([tenantId, assignedMembershipId])
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @db.Uuid
  orderId        String        @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod
  reference      String?
  note           String?
  receivedById   String?       @db.Uuid
  idempotencyKey String?
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, orderId])
  @@index([tenantId, createdAt])
}

/// Append-only order timeline.
model OrderStatusHistory {
  id          String       @id @default(uuid()) @db.Uuid
  tenantId    String       @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  actorUserId String?      @db.Uuid
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, orderId, createdAt])
}
